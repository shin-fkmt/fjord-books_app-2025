<p style="color: green"><%= notice %></p>

<% content_for :title, t('common.index.title', name: Book.model_name.human(count: 2)) %>

<h1><%= t('common.index.title', name: Book.model_name.human(count: 2)) %></h1>

<div id="books" class="index-items">
  <% @books.each do |book| %>
    <div class="index-item">
      <%= render book %>
      <p>
        <%= link_to t('common.link_label.show', name: Book.model_name.human.downcase), book %>
      </p>
    </div>
  <% end %>
</div>

<nav class="page-nav">
  <%= link_to t('common.link_label.new', name: Book.model_name.human.downcase), new_book_path %>
</nav>
