<div id="<%= dom_id comment %>" class="show-item">
  <p>
    <strong><%= User.human_attribute_name(:name) %>:</strong>
    <%= comment.user.name.presence || comment.user.email %>
  </p>
  <p>
    <strong><%= Comment.human_attribute_name(:updated_at) %>:</strong>
    <%= l(comment.updated_at, format: :long) %>
  </p>
  <p>
    <strong><%= Comment.human_attribute_name(:comment) %>:</strong>
    <%= comment.comment %>
  </p>
  <div>
    <% if current_user == comment.user %>
      <hr>
      <div>
        <%= link_to t('views.common.edit', name: Comment.model_name.human.downcase), edit_comment_path(comment) %>
        <%= button_to t('views.common.destroy', name: Comment.model_name.human.downcase), comment, method: :delete %>
      </div>
    <% end %>
  </div>
</div>
